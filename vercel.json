{
    "rewrites": [
        {
            "source": "/main/(.*)",
            "destination": "/index.html"
        },
        {
            "source": "/main",
            "destination": "/index.html"
        }
    ],
    "redirects": [
        {
            "source": "/",
            "destination": "/main",
            "permanent": true
        }
    ]
}