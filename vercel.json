{
    "rewrites": [
        {
            "source": "/main/VOLTSNAP/(.*)",
            "destination": "/VOLTSNAP/$1"
        },
        {
            "source": "/main/portofolio/(.*)",
            "destination": "/portofolio/$1"
        },
        {
            "source": "/main/assets/(.*)",
            "destination": "/assets/$1"
        },
        {
            "source": "/main/((?!assets/|VOLTSNAP/|portofolio/|.*\\.).*)",
            "destination": "/index.html"
        }
    ],
    "redirects": [
        {
            "source": "/",
            "destination": "/main",
            "permanent": true
        }
    ]
}